# Fill in <password> below with your Supabase database password.

# Transaction-mode pooler (IPv4-only) — used by the app at runtime
DATABASE_URL="postgresql://postgres.ibxzuxajjwmvzdbsduwc:<password>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session-mode pooler — used by Prisma Migrate
DIRECT_URL="postgresql://postgres.ibxzuxajjwmvzdbsduwc:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Supabase project (find these in Project Settings > API)
SUPABASE_URL="https://ibxzuxajjwmvzdbsduwc.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

PORT=3000
FRONTEND_URL="http://localhost:5173"

# Resend (https://resend.com) — used to email org invites. Without a
# verified domain, Resend only delivers to the account's own signup email.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Razorpay (https://dashboard.razorpay.com) — domestic (INR) org subscription
# payments. Billing endpoints return 503 until these are set.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Stripe (https://dashboard.stripe.com) — international (USD) org subscription
# payments. Billing endpoints return 503 until these are set.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Supabase Storage S3-compatible API — used for issue attachments. Find these
# in Project Settings > Storage > S3 Connection. Attachment upload/delete
# return 503 until these are set.
S3_ENDPOINT="https://ibxzuxajjwmvzdbsduwc.storage.supabase.co/storage/v1/s3"
S3_REGION="ap-northeast-1"
S3_BUCKET="mangeme_attachments"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# GitHub App (Developer settings > GitHub Apps) — lets an org admin connect a
# GitHub account and create branches from tickets. Git endpoints return 503
# until GITHUB_APP_ID/GITHUB_APP_PRIVATE_KEY are set.
GITHUB_APP_ID=""
# PEM private key downloaded from the App's settings page. Escape newlines as
# literal "\n" if setting this as a single-line env var.
GITHUB_APP_PRIVATE_KEY=""
# The App's URL slug, e.g. "my-manageme-app" from github.com/apps/<slug>.
GITHUB_APP_SLUG=""
# Webhook secret configured on the App, used to verify POST /webhooks/github.
GITHUB_WEBHOOK_SECRET=""
# Any random string — signs the short-lived state param used in the
# connect/callback redirect flow. Not tied to GitHub itself.
GITHUB_STATE_SECRET=""
