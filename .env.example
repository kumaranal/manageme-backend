# Fill in <password> below with your Supabase database password.

# Transaction-mode pooler (IPv4-only) — used by the app at runtime
DATABASE_URL="postgresql://postgres.ibxzuxajjwmvzdbsduwc:<password>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session-mode pooler — used by Prisma Migrate
DIRECT_URL="postgresql://postgres.ibxzuxajjwmvzdbsduwc:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Supabase project (find these in Project Settings > API)
SUPABASE_URL="https://ibxzuxajjwmvzdbsduwc.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

PORT=3000
FRONTEND_URL="http://localhost:5173"

# Resend (https://resend.com) — used to email org invites. Without a
# verified domain, Resend only delivers to the account's own signup email.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Razorpay (https://dashboard.razorpay.com) — domestic (INR) org subscription
# payments. Billing endpoints return 503 until these are set.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Stripe (https://dashboard.stripe.com) — international (USD) org subscription
# payments. Billing endpoints return 503 until these are set.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
