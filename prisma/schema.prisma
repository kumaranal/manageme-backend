generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Mirrors auth.users (Supabase Auth). Row is created/synced on first login.
model User {
  id            String   @id @db.Uuid
  email         String   @unique
  name          String
  initials      String
  isSuperadmin  Boolean  @default(false)
  createdAt     DateTime @default(now())

  memberships        Membership[]
  projectMemberships ProjectMembership[]
  leadOfProjects      Project[]           @relation("ProjectLead")
  assignedIssues      Issue[]             @relation("IssueAssignee")
  ccOnIssues          IssueCc[]
  comments            Comment[]
  activityEntries     ActivityEntry[]
  storeItemUpdates    StoreItem[]         @relation("StoreItemUpdatedBy")
  storeHistoryEntries StoreHistoryEntry[]
  checkoutSessions    CheckoutSession[]
  payments            Payment[]

  @@map("users")
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

model Organization {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique
  initial              String
  status               OrgStatus @default(ACTIVE)
  capacityHoursPerWeek Int       @default(40)
  createdAt            DateTime  @default(now())

  members      Membership[]
  invites      Invite[]
  projects     Project[]
  subscription Subscription?
  payments     Payment[]

  @@map("organizations")
}

enum OrgRole {
  ORG_ADMIN
  MEMBER
}

model Membership {
  orgId  String
  userId String  @db.Uuid
  role   OrgRole

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
  @@map("memberships")
}

model Invite {
  id        String   @id @default(cuid())
  orgId     String
  email     String
  role      OrgRole
  token     String   @unique @default(cuid())
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("invites")
}

model Project {
  id            String   @id @default(cuid())
  orgId         String
  key           String
  name          String
  blurb         String   @default("")
  leadId        String   @db.Uuid
  counter       Int      @default(0)
  archived      Boolean  @default(false)
  sprintLengthWeeks Int  @default(2)
  createdAt     DateTime @default(now())

  org           Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead          User                @relation("ProjectLead", fields: [leadId], references: [id])
  members       ProjectMembership[]
  taskFields    TaskField[]
  statuses      Status[]
  sprints       Sprint[]
  issues        Issue[]
  storeItems    StoreItem[]

  @@unique([orgId, key])
  @@map("projects")
}

enum ProjectRole {
  LEAD
  CONTRIBUTOR
  VIEWER
}

model ProjectMembership {
  projectId   String
  userId      String      @db.Uuid
  role        ProjectRole
  weeklyHours Int?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_memberships")
}

enum TaskFieldKey {
  priority
  assignee
  dueDate
  labels
  estimatedHours
}

model TaskField {
  projectId String
  fieldKey  TaskFieldKey
  label     String
  enabled   Boolean @default(true)
  required  Boolean @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, fieldKey])
  @@map("task_fields")
}

enum StatusCategory {
  TODO
  IN_PROGRESS
  DONE
}

model Status {
  id       String         @id @default(cuid())
  projectId String
  name     String
  category StatusCategory
  position Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@unique([projectId, position])
  @@map("statuses")
}

enum SprintStatus {
  PLANNED
  ACTIVE
  CLOSED
}

model Sprint {
  id        String       @id @default(cuid())
  projectId String
  name      String
  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date
  status    SprintStatus @default(PLANNED)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@map("sprints")
}

enum IssueType {
  Task
  Story
  Bug
}

enum Priority {
  Urgent
  High
  Medium
  Low
}

model Issue {
  id             String    @id @default(cuid())
  projectId      String
  number         Int
  title          String
  type           IssueType
  priority       Priority
  assigneeId     String?   @db.Uuid
  statusId       String
  rank           Float
  due            DateTime? @db.Date
  labels         String[]  @default([])
  estimatedHours Float?
  sprintId       String?
  createdAt      DateTime  @default(now())

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?           @relation("IssueAssignee", fields: [assigneeId], references: [id])
  status   Status          @relation(fields: [statusId], references: [id])
  sprint   Sprint?         @relation(fields: [sprintId], references: [id])
  cc       IssueCc[]
  comments Comment[]
  activity ActivityEntry[]

  @@unique([projectId, number])
  @@index([projectId, statusId])
  @@map("issues")
}

model IssueCc {
  issueId String
  userId  String @db.Uuid

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([issueId, userId])
  @@map("issue_cc")
}

model Comment {
  id        String   @id @default(cuid())
  issueId   String
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])

  @@map("comments")
}

model ActivityEntry {
  id        String   @id @default(cuid())
  issueId   String
  actorId   String   @db.Uuid
  text      String
  createdAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor User  @relation(fields: [actorId], references: [id])

  @@map("activity_entries")
}

enum StoreKind {
  DOC
  ENV
  LINK
  NOTE
}

model StoreItem {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  kind        StoreKind
  content     String
  updatedById String    @db.Uuid
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedBy User                @relation("StoreItemUpdatedBy", fields: [updatedById], references: [id])
  history   StoreHistoryEntry[]

  @@map("store_items")
}

model StoreHistoryEntry {
  id          String   @id @default(cuid())
  storeItemId String
  actorId     String   @db.Uuid
  text        String
  at          DateTime @default(now())

  storeItem StoreItem @relation(fields: [storeItemId], references: [id], onDelete: Cascade)
  actor     User      @relation(fields: [actorId], references: [id])

  @@map("store_history_entries")
}

// --- Billing --------------------------------------------------------------
// Money is stored as integer smallest-unit amounts (paise for INR, cents for
// USD) — matches what Razorpay/Stripe expect natively and avoids float math.

enum BillingCurrency {
  INR
  USD
}

enum PaymentGateway {
  RAZORPAY
  STRIPE
}

enum CheckoutKind {
  NEW_ORG
  RENEWAL
}

enum CheckoutStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

enum CouponDiscountType {
  PERCENT
  FIXED
}

model SubscriptionPlan {
  id            String   @id @default(cuid())
  name          String
  description   String   @default("")
  periodDays    Int
  priceInrPaise Int
  priceUsdCents Int
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  checkoutSessions CheckoutSession[]
  subscriptions    Subscription[]

  @@map("subscription_plans")
}

model Coupon {
  id               String             @id @default(cuid())
  code             String             @unique
  discountType     CouponDiscountType
  percentOff       Int?
  fixedOffInrPaise Int?
  fixedOffUsdCents Int?
  maxRedemptions   Int?
  timesRedeemed    Int                @default(0)
  active           Boolean            @default(true)
  expiresAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  checkoutSessions CheckoutSession[]

  @@map("coupons")
}

// Holds checkout intent until payment is confirmed — the Organization row
// itself is only created once a checkout finalizes successfully.
model CheckoutSession {
  id     String       @id @default(cuid())
  userId String       @db.Uuid
  kind   CheckoutKind

  orgName    String? // set when kind = NEW_ORG
  renewOrgId String? // set when kind = RENEWAL

  planId   String
  couponId String?
  currency BillingCurrency
  gateway  PaymentGateway

  subtotalAmount Int
  discountAmount Int            @default(0)
  totalAmount    Int
  status         CheckoutStatus @default(PENDING)

  gatewayOrderId   String? // razorpay order id / stripe checkout session id
  gatewayPaymentId String? // set once payment is confirmed
  createdOrgId     String? // set once the org is created (kind = NEW_ORG)

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User             @relation(fields: [userId], references: [id])
  plan    SubscriptionPlan @relation(fields: [planId], references: [id])
  coupon  Coupon?          @relation(fields: [couponId], references: [id])
  payment Payment?

  @@map("checkout_sessions")
}

// No stored status: "expired" is computed as currentPeriodEnd < now()
// wherever it's read, so there's no cron job needed to keep it in sync.
model Subscription {
  id                 String   @id @default(cuid())
  orgId              String   @unique
  planId             String
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  org      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@map("subscriptions")
}

// Immutable ledger of successful charges only — created exclusively by the
// checkout finalize step. This is the source of truth for financial analytics.
model Payment {
  id                String   @id @default(cuid())
  checkoutSessionId String   @unique
  orgId             String
  subscriptionId    String
  userId            String   @db.Uuid
  gateway           PaymentGateway
  currency          BillingCurrency
  amount            Int
  gatewayPaymentId  String
  createdAt         DateTime @default(now())

  checkoutSession CheckoutSession @relation(fields: [checkoutSessionId], references: [id])
  org             Organization    @relation(fields: [orgId], references: [id])
  subscription    Subscription    @relation(fields: [subscriptionId], references: [id])
  user            User            @relation(fields: [userId], references: [id])

  @@map("payments")
}
